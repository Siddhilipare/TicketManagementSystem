@model IEnumerable<TicketModel.Models.TicketModel>
@using System.Linq
@{
    ViewBag.Title = "Completed Archive";
    ViewBag.ActiveTab = "SupportDashboard";
}

<div style="margin-bottom: 20px;">
    <a href="@Url.Action("Index", "Support")" class="back-link-btn">
        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div style="margin-bottom: 28px;">
    <div class="accent-text">Resolved Complaints</div>
    <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 6px;">Completed Archive</h2>
    <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 0;">Tickets resolved more than 30 minutes ago. Move a ticket back to your active board if the issue requires further attention.</p>
</div>

<!-- SEARCH + FILTER BAR -->
<div class="luxury-card" style="padding: 20px; margin-bottom: 24px; position: relative; z-index: 100;">
    <form id="caFilterForm" method="get" data-search="@(ViewBag.Search ?? "")" data-date="@(ViewBag.SelectedDate ?? "")" data-sort-order="@(ViewBag.SortOrder ?? "newest")" data-priority-filter="@(ViewBag.PriorityFilter != null ? ViewBag.PriorityFilter.ToString() : "")" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
        <div style="flex-grow: 1; min-width: 240px;">
            <input type="text" name="search" id="caSearch" value="@ViewBag.Search"
                   placeholder="Search by title, employee name, or ID..." class="form-control" />
        </div>

        <div class="dropdown" style="position: relative;">
            <button type="button" class="btn-secondary-gold dropdown-toggle" data-toggle="dropdown"
                    style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px;">
                <i class="fa-solid fa-filter" style="font-size: 16px; color: var(--accent-primary);"></i>
                <span>Filter</span>
                <i class="fa-solid fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-right funnel-filter-panel" onclick="event.stopPropagation();">
                <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                    <span><i class="fa-solid fa-filter" style="margin-right: 4px;"></i> Funnel Filter</span>
                    <span style="font-size: 10px; color: var(--text-secondary); font-weight: normal;">Refine Archive</span>
                </div>

                <!-- Priority filter -->
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-flag" style="margin-right: 4px;"></i> Filter by Priority
                    </label>
                    <select name="priorityFilter" id="caPriority" class="form-control" style="font-size: 13px;">
                        <option value="">All Priorities</option>
                        <option value="1" @(ViewBag.PriorityFilter != null && (int)ViewBag.PriorityFilter == 1 ? "selected" : "")>Low</option>
                        <option value="2" @(ViewBag.PriorityFilter != null && (int)ViewBag.PriorityFilter == 2 ? "selected" : "")>Medium</option>
                        <option value="3" @(ViewBag.PriorityFilter != null && (int)ViewBag.PriorityFilter == 3 ? "selected" : "")>High</option>
                    </select>
                </div>

                <!-- Date & sort -->
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-calendar-days" style="margin-right: 4px;"></i> Sort by Completed Date
                    </label>
                    <select name="sortOrder" id="caSort" class="form-control" style="margin-bottom: 10px; font-size: 13px;">
                        <option value="newest" @(ViewBag.SortOrder == "oldest" ? "" : "selected")>1. Newest to Oldest</option>
                        <option value="oldest" @(ViewBag.SortOrder == "oldest" ? "selected" : "")>2. Oldest to Newest</option>
                    </select>
                    <label class="form-label" style="font-size: 11px; margin-bottom: 4px; color: var(--text-secondary);">Specific Completed Date</label>
                    <input type="date" name="date" id="caDate" value="@ViewBag.SelectedDate" class="form-control" style="font-size: 13px;" />
                </div>

                <div style="display: flex; gap: 10px; margin-top: 14px;">
                    <button type="submit" class="btn-primary-gold" style="flex: 1; padding: 6px 0; font-size: 12px;" onclick="clearCAState()">
                        <i class="fa-solid fa-check"></i> Apply
                    </button>
                    <a href="@Url.Action("CompletedArchive", "Support")" class="btn-secondary-gold"
                       style="padding: 6px 12px; font-size: 12px; border-color: var(--border-subtle); color: var(--text-secondary);"
                       onclick="clearCAState()">Reset</a>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary-gold" onclick="clearCAState()">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <a href="@Url.Action("CompletedArchive", "Support")" class="btn-secondary-gold"
           style="border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearCAState()">
            <i class="fa-solid fa-rotate-left"></i> Reset
        </a>
        <button type="button" id="exportArchiveBtn" class="btn-secondary-gold"
        data-export-url="@Url.Action("ExportCompletedArchiveCsv", "Support", new { search = ViewBag.Search, date = ViewBag.SelectedDate, sortOrder = ViewBag.SortOrder, priorityFilter = ViewBag.PriorityFilter })">
    <i class="fa-solid fa-file-csv"></i> <span class="export-btn-label">Export</span>
</button>
    </form>
</div>

@if (Model != null && Model.Any())
{
    <div id="caCardsWrapper">
        @{ int caIdx = 0; }
        @foreach (var item in Model)
        {
            string closedDateStr = item.TicketClosedDate.HasValue ? item.TicketClosedDate.Value.ToString("MMM dd, yyyy hh:mm tt") : "N/A";

            <!-- CARD: exact same HTML as original, only added class="ca-card" and data-idx for pagination JS -->
            <div class="ca-card luxury-card" data-idx="@caIdx"
                 style="padding: 20px; margin-bottom: 16px; display: none; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                <div>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 16px; margin-bottom: 4px;">@item.Title</div>
                    <div style="color: var(--text-secondary); font-size: 13px;">
                        <span style="font-family: monospace; font-weight: 700; color: var(--accent-primary);">TICK-@item.TicketId.ToString("D4")</span>
                        &bull; Raised by: <strong>@item.RaisedByName</strong> &bull; Completed: @closedDateStr
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <span class="badge-pill-luxury @(item.PriorityName != null && item.PriorityName.ToLower() == "medium" ? "badge-priority-medium" : item.PriorityName != null && item.PriorityName.ToLower() == "high" ? "badge-priority-high" : item.PriorityName != null && item.PriorityName.ToLower() == "critical" ? "badge-priority-critical" : "badge-priority-low")" style="margin-right: 4px;">@(string.IsNullOrEmpty(item.PriorityName) ? "Normal" : item.PriorityName)</span>
                    <span class="badge-pill-luxury badge-status-closed">COMPLETED</span>

                    @using (Html.BeginForm("MoveBackToProgress", "Support", FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@item.TicketId" />
                        <button type="submit" class="btn-secondary-gold"
                                style="padding: 6px 14px; font-size: 12px; display: inline-flex; align-items: center; gap: 6px;"
                                onclick="return confirm('Move this ticket back to your active board?');">
                            <i class="fa-solid fa-rotate-left"></i> Move Back to Panel
                        </button>
                    }

                    <a href="@Url.Action("Details", "Support", new { id = item.TicketId })"
                       class="btn-primary-gold"
                       style="padding: 6px 14px; font-size: 12px; display: inline-flex; align-items: center; gap: 6px;"
                       onclick="saveCAState()">
                        <i class="fa-solid fa-eye"></i> View
                    </a>
                </div>
            </div>
            caIdx++;
        }
    </div>

    <div id="caPaginationBar" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap;"></div>
    <div id="caPageInfo" style="text-align: center; font-size: 12px; color: var(--text-tertiary); margin-top: 8px;"></div>
  }          
else
{
    <div class="luxury-card" style="padding: 48px; text-align: center; color: var(--text-secondary);">
        <i class="fa-solid fa-box-archive" style="font-size: 48px; color: var(--accent-primary); margin-bottom: 16px;"></i>
        <h3 style="color: var(--text-primary);">No completed tickets in archive</h3>
        <p>Tickets appear here 30 minutes after being marked Completed.</p>
        <a href="@Url.Action("Board", "Support")" class="btn-primary-gold" style="margin-top: 12px; display: inline-flex;">Go to Ticket Board</a>
    </div>
}

@section scripts {
    <script src="~/Content/RequiredJs/Support/CompletedArchive.js"></script>
}
