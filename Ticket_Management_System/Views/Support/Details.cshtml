@model TicketModel.Models.TicketModel
@using System.Linq
@using System.Text.RegularExpressions
@{
    ViewBag.Title = "Ticket Details";
    ViewBag.ActiveTab = "SupportBoard";
    var comments = ViewBag.Comments as List<TicketModel.Models.TicketCommentModel>;
    var attachments = ViewBag.Attachments as List<TicketModel.Models.TicketAttachmentModel>;
    int currentUserId = ((System.Security.Claims.ClaimsPrincipal)User)
        .FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub) != null
        ? Convert.ToInt32(((System.Security.Claims.ClaimsPrincipal)User)
            .FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub).Value)
        : 0;

    bool isArchived = Model.StatusId == 4 && Model.TicketClosedDate.HasValue
                      && (DateTime.Now - Model.TicketClosedDate.Value).TotalMinutes >= 30;
}

<div style="margin-bottom: 20px;">
    <a href="@Url.Action("Board", "Support")" class="back-link-btn">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>
</div>

<!-- Header Hero Card -->
<div class="luxury-hero" style="padding: 28px 36px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
            <span style="font-family: monospace; font-weight: 700; color: var(--accent-primary); font-size: 16px;">TICK-@Model.TicketId.ToString("D4")</span>
            <span class="badge-pill-luxury @(Model.PriorityName != null && Model.PriorityName.ToLower() == "medium" ? "badge-priority-medium" : Model.PriorityName != null && Model.PriorityName.ToLower() == "high" ? "badge-priority-high" : Model.PriorityName != null && Model.PriorityName.ToLower() == "critical" ? "badge-priority-critical" : "badge-priority-low")">@(string.IsNullOrEmpty(Model.PriorityName) ? "Normal" : Model.PriorityName) Priority</span>
        </div>
        <h2 class="luxury-heading" style="font-size: 28px; margin: 0;">@Model.Title</h2>
        <div style="color: var(--text-secondary); font-size: 13px; margin-top: 6px;">
            Raised by <strong>@Model.RaisedByName</strong> &bull; @Model.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 28px;">
    <!-- Description Card -->
    <div class="luxury-card" style="padding: 24px;">
        <h4 style="color: var(--accent-primary); font-size: 16px; margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-align-left"></i> Description
        </h4>
        <p style="color: var(--text-primary); font-size: 14px; line-height: 1.6; margin: 0; white-space: pre-wrap;">@Model.Description</p>
    </div>

    <!-- Employee Attachments Card -->
    <div class="luxury-card" style="padding: 24px;">
        <h4 style="color: var(--accent-primary); font-size: 16px; margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-paperclip"></i> Employee Attachments
        </h4>
        @if (attachments != null && attachments.Any())
        {
            <div class="attachment-grid">
                @foreach (var a in attachments)
                {
                    string ext = System.IO.Path.GetExtension(a.FilePath).TrimStart('.').ToLower();
                    bool isImage = ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "gif" || ext == "bmp";
                    string iconClass = ext == "pdf" ? "fa-file-pdf"
                                     : (ext == "doc" || ext == "docx") ? "fa-file-word"
                                     : ext == "txt" ? "fa-file-lines" : "fa-file";
                    string fileName = System.IO.Path.GetFileName(a.FilePath);

                    <div class="attachment-card" title="@fileName">
                        @if (isImage)
                        {
                            <a href="@a.FilePath" target="_blank" style="width: 100%; height: 100%;">
                                <img src="@a.FilePath" alt="@fileName" />
                            </a>
                        }
                        else
                        {
                            <a href="@a.FilePath" target="_blank" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; width: 100%; height: 100%; padding: 8px;">
                                <i class="fa-solid @iconClass file-icon"></i>
                                <span class="file-name">@fileName</span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: var(--text-tertiary); font-size: 13px; margin: 0;">No employee attachments uploaded.</p>
        }
    </div>
</div>

<!-- Conversation History + Chat Input -->
<div class="luxury-card" style="padding: 28px;">
    <h4 style="color: var(--accent-primary); font-size: 18px; margin-top: 0; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-comments"></i> Conversation History
    </h4>

    <!-- Chat thread -->
    <div class="chat-thread" style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px; max-height: 440px; overflow-y: auto; padding-right: 8px;">
        @if (comments != null && comments.Any())
        {
            foreach (var c in comments)
            {
                bool isMine = c.CommentedbyUserId == currentUserId;
                string text = c.CommentText ?? "";

                Match imgMatch = Regex.Match(text, @"\[IMAGE:(.*?)\]");
                Match fileMatch = Regex.Match(text, @"\[FILE:(.*?)\|(.*?)\]");

                string cleanText = text;
                if (imgMatch.Success) { cleanText = cleanText.Replace(imgMatch.Value, "").Trim(); }
                if (fileMatch.Success) { cleanText = cleanText.Replace(fileMatch.Value, "").Trim(); }

                <div style="display: flex; justify-content: @(isMine ? "flex-end" : "flex-start");">
                    <div style="max-width: 75%;
                                background: @(isMine ? "var(--accent-primary)" : "var(--bg-tertiary)");
                                color: @(isMine ? "var(--text-inverse)" : "var(--text-primary)");
                                border: 1px solid @(isMine ? "var(--accent-primary)" : "var(--border-subtle)");
                                border-radius: 12px; padding: 14px 18px; box-shadow: var(--shadow-sm);">

                        <div style="font-weight: 700; font-size: 12px; opacity: 0.9; margin-bottom: 4px;">@c.CommentedByName</div>

                        @if (!string.IsNullOrEmpty(cleanText))
                        {
                            <div style="font-size: 14px; line-height: 1.5; word-break: break-word;">@cleanText</div>
                        }

                        @if (imgMatch.Success)
                        {
                            string imgUrl = imgMatch.Groups[1].Value;
                            <div style="margin-top: 8px;">
                                <a href="@imgUrl" target="_blank" style="display: inline-block;">
                                    <img src="@imgUrl" style="max-width: 240px; max-height: 180px; border-radius: 8px; border: 1.5px solid var(--border-color); object-fit: cover;" />
                                </a>
                            </div>
                        }

                        @if (fileMatch.Success)
                        {
                            string fileUrl = fileMatch.Groups[1].Value;
                            string fileName2 = fileMatch.Groups[2].Value;
                            string fext = System.IO.Path.GetExtension(fileUrl).TrimStart('.').ToLower();
                            string ficon = fext == "pdf" ? "fa-file-pdf"
                                            : (fext == "doc" || fext == "docx") ? "fa-file-word"
                                            : fext == "txt" ? "fa-file-lines" : "fa-file";
                            <div style="margin-top: 8px;">
                                <a href="@fileUrl" target="_blank"
                                   style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);
                                          color: inherit; padding: 8px 14px; border-radius: 6px; font-size: 12px;
                                          display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                                    <i class="fa-solid @ficon" style="font-size: 16px;"></i>
                                    <span>@fileName2</span>
                                </a>
                            </div>
                        }

                        <div style="font-size: 10px; opacity: 0.75; text-align: right; margin-top: 6px;">@c.CreatedOn.ToString("hh:mm tt")</div>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 32px 16px; color: var(--text-tertiary); font-size: 13px;">
                No comments yet. Start the conversation below.
            </div>
        }
    </div>

    @if (!isArchived)
    {
        using (Html.BeginForm("AddComment", "Support", FormMethod.Post,
               new { enctype = "multipart/form-data", style = "display: flex; flex-direction: column; gap: 8px;" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="ticketId" value="@Model.TicketId" />

            <div style="display: flex; gap: 10px; align-items: center; position: relative;">
                <div style="flex-grow: 1; position: relative; display: flex; align-items: center;">
                    <input type="text" name="commentText" id="chatCommentText"
                           class="form-control"
                           placeholder="Type a message�"
                           style="height: 46px; font-size: 14px; padding-right: 48px;" />

                    <input type="file" id="chatFileInput" name="chatFile"
                           accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.txt"
                           style="position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; z-index: -1;"
                           onchange="handleChatFileSelect(this)" />

                    <label for="chatFileInput"
                           title="Attach file (PDF, Word, Excel, Images)"
                           style="position: absolute; right: 14px; margin: 0; cursor: pointer;
                                  color: var(--accent-primary); font-size: 20px;
                                  transition: transform 0.15s ease; z-index: 5;">
                        <i class="fa-solid fa-paperclip"></i>
                    </label>
                </div>

                <button type="submit" class="btn-primary-gold"
                        style="padding: 10px 24px; font-size: 13px; height: 46px;
                               display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;">
                    <i class="fa-solid fa-paper-plane"></i> Send
                </button>
            </div>

            <div id="chatFilePreviewBadge"
                 style="display: none; align-items: center; gap: 8px;
                        background: var(--bg-tertiary); border: 1px solid var(--accent-primary);
                        padding: 6px 12px; border-radius: 6px; width: fit-content;
                        font-size: 12px; color: var(--accent-primary); font-weight: 600;">
                <i class="fa-solid fa-paperclip"></i>
                <span id="chatFilePreviewName"></span>
                <button type="button" onclick="removeChatFileSelect()"
                        style="background: none; border: none; color: var(--error);
                               cursor: pointer; font-size: 16px; margin-left: 4px; line-height: 1;">
                    &times;
                </button>
            </div>
        }
    }
</div>

@section scripts {
    <script src="~/Content/RequiredJs/Support/Details.js"></script>
}
