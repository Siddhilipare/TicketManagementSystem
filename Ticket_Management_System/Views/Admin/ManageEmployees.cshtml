@model IEnumerable<TicketModel.Models.UserListModel>
@{
    ViewBag.Title = "Manage Employees";
    ViewBag.ActiveTab = "AdminEmployees";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <a href="@Url.Action("AllTickets", "Admin")" class="btn-secondary-gold" style="padding: 6px 14px; font-size: 12px; margin-bottom: 8px; display: inline-flex;">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">Employee Account Management</h2>
        <p style="margin: 6px 0 0; font-size: 13px; color: var(--text-secondary);">
            Decide which employees can use this site. Use the button below to activate or deactivate access.
        </p>
    </div>
</div>

<!-- Search Bar -->
<div class="luxury-card" style="padding: 20px; margin-bottom: 28px;">
    @using (Html.BeginForm("ManageEmployees", "Admin", FormMethod.Get, new { id = "employeeFilterForm", data_search = (ViewBag.Search ?? "").ToString(), style = "display: flex; gap: 14px; align-items: center; flex-wrap: wrap;" }))
    {
        <div style="flex-grow: 1; min-width: 240px;">
            <input type="text" name="search" id="searchInput" value="@ViewBag.Search" placeholder="Search by name or email..." class="form-control" />
        </div>
        <button type="submit" class="btn-primary-gold" onclick="clearState()"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        <a href="@Url.Action("ManageEmployees", "Admin")" class="btn-secondary-gold" style="border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearState()"><i class="fa-solid fa-rotate-left"></i> Reset</a>
    }
</div>

<div class="luxury-table-wrapper">
    @if (Model != null && Model.Any())
    {
        <table class="luxury-table" id="employeesTable">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>User Name</th>
                    <th>Email Address</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="employeesBody">
                @foreach (var u in Model)
                {
                    <tr class="employee-row @(u.IsActive ? "" : "opacity-75")" style="display:none;">
                        <td style="font-weight: 700; color: var(--accent-primary); font-family: monospace;">USR-@u.UserId.ToString("D4")</td>
                        <td style="font-weight: 600;">@(u.UserName ?? u.Email)</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@u.Email</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span style="color: var(--success); font-weight: 700; font-size: 12px;"><i class="fa-solid fa-circle" style="font-size: 8px; margin-right: 4px;"></i> Active</span>
                            }
                            else
                            {
                                <span style="color: var(--error); font-weight: 700; font-size: 12px;"><i class="fa-solid fa-circle" style="font-size: 8px; margin-right: 4px;"></i> Inactive</span>
                            }
                        </td>
                        <td style="text-align: right;">
                            @if (u.IsActive)
                            {
                                using (Html.BeginForm("ToggleUserActive", "Admin", FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <input type="hidden" name="isActive" value="false" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("ManageEmployees", "Admin")" />
                                    <button type="submit" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px; border-color: var(--error); color: var(--error);" onclick="saveState(); return confirm('Deactivate this employee? They will lose access to this site.');">
                                        <i class="fa-solid fa-user-slash"></i> Deactivate
                                    </button>
                                }
                            }
                            else
                            {
                                using (Html.BeginForm("ToggleUserActive", "Admin", FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <input type="hidden" name="isActive" value="true" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("ManageEmployees", "Admin")" />
                                    <button type="submit" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px; border-color: var(--success); color: var(--success);" onclick="saveState();">
                                        <i class="fa-solid fa-user-check"></i> Activate
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="paginationBar" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap;"></div>
        <div id="pageInfo" style="text-align: center; font-size: 12px; color: var(--text-tertiary); margin-top: 8px;"></div>
    }
    else
    {
        <div style="text-align: center; padding: 48px 20px; color: var(--text-secondary);">
            <i class="fa-solid fa-users" style="font-size: 32px; margin-bottom: 12px;"></i>
            <div>@(string.IsNullOrEmpty(ViewBag.Search) ? "No employees registered yet." : "No employees match your search.")</div>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section scripts {
    <script src="~/Content/RequiredJs/Admin/ManageEmployees.js"></script>
}