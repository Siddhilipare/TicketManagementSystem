@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.ActiveTab = "AdminDashboard";

    // Stats computed from the model in ViewBag
    int totalTickets = ViewBag.TotalTickets ?? 0;
    int openTickets = ViewBag.OpenTickets ?? 0;
    int inProgressTickets = ViewBag.InProgressTickets ?? 0;
    int completedTickets = ViewBag.CompletedTickets ?? 0;
    int resolvedThisWeek = ViewBag.ResolvedThisWeek ?? 0;
    int unassigned = ViewBag.UnassignedTickets ?? 0;
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int activeSupport = ViewBag.ActiveSupport ?? 0;

    var recentTickets = ViewBag.RecentTickets as List<TicketModel.Models.TicketModel>;
}

<div style="margin-bottom: 28px;">
    <div class="accent-text">System Overview</div>
    <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">Admin Dashboard</h2>
</div>

<!-- Stat cards row 1: Tickets -->
<div class="stats-grid" style="margin-bottom: 20px;">
    <a href="@Url.Action("AllTickets", "Admin")" style="text-decoration: none;">
        <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-ticket"></i></div>
            <div>
                <div class="stat-number">@totalTickets</div>
                <div class="stat-label">Total Tickets</div>
            </div>
        </div>
    </a>

    <a href="@Url.Action("AllTickets", "Admin", new { view = "unassigned" })" style="text-decoration: none;">
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--warning);"><i class="fa-solid fa-folder-open"></i></div>
            <div>
                <div class="stat-number">@unassigned</div>
                <div class="stat-label">Unassigned</div>
            </div>
        </div>
    </a>

    <div class="stat-card">
        <div class="stat-icon" style="color: var(--info);"><i class="fa-solid fa-spinner"></i></div>
        <div>
            <div class="stat-number">@inProgressTickets</div>
            <div class="stat-label">In Progress</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="color: var(--success);"><i class="fa-solid fa-circle-check"></i></div>
        <div>
            <div class="stat-number">@completedTickets</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>
</div>

<!-- Stat cards row 2: Users + this-week -->
<div class="stats-grid" style="margin-bottom: 32px;">
    <a href="@Url.Action("ManageUsers", "Admin")" style="text-decoration: none;">
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--accent-primary);"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="stat-number">@totalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
    </a>

    <div class="stat-card">
        <div class="stat-icon" style="color: var(--accent-primary);"><i class="fa-solid fa-headset"></i></div>
        <div>
            <div class="stat-number">@activeSupport</div>
            <div class="stat-label">Support Executives</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="color: var(--success);"><i class="fa-solid fa-calendar-check"></i></div>
        <div>
            <div class="stat-number">@resolvedThisWeek</div>
            <div class="stat-label">Resolved This Week</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="color: var(--warning);"><i class="fa-solid fa-hourglass-half"></i></div>
        <div>
            <div class="stat-number">@openTickets</div>
            <div class="stat-label">Open (To Do)</div>
        </div>
    </div>
</div>

<!-- Analytics charts -->
<div id="dashboardChartsRoot"
     data-status-labels='@Html.Raw(ViewBag.StatusChartLabelsJson)'
     data-status-data='@Html.Raw(ViewBag.StatusChartDataJson)'
     data-priority-labels='@Html.Raw(ViewBag.PriorityChartLabelsJson)'
     data-priority-data='@Html.Raw(ViewBag.PriorityChartDataJson)'
     data-trend-labels='@Html.Raw(ViewBag.TrendLabelsJson)'
     data-trend-created='@Html.Raw(ViewBag.TrendCreatedJson)'
     data-trend-resolved='@Html.Raw(ViewBag.TrendResolvedJson)'
     style="margin-bottom: 32px;">

    <div class="accent-text" style="margin-bottom: 12px;">Analytics</div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
        <div class="luxury-card" style="padding: 20px;">
            <div style="font-weight: 700; color: var(--text-primary); font-size: 14px; margin-bottom: 12px;">
                <i class="fa-solid fa-chart-pie" style="color: var(--accent-primary); margin-right: 8px;"></i>
                Tickets by Status
            </div>
            <canvas id="statusChart" style="max-height: 260px;"></canvas>
        </div>

        <div class="luxury-card" style="padding: 20px;">
            <div style="font-weight: 700; color: var(--text-primary); font-size: 14px; margin-bottom: 12px;">
                <i class="fa-solid fa-chart-column" style="color: var(--accent-primary); margin-right: 8px;"></i>
                Tickets by Priority
            </div>
            <canvas id="priorityChart" style="max-height: 260px;"></canvas>
        </div>
    </div>

    <div class="luxury-card" style="padding: 20px;">
        <div style="font-weight: 700; color: var(--text-primary); font-size: 14px; margin-bottom: 12px;">
            <i class="fa-solid fa-chart-line" style="color: var(--accent-primary); margin-right: 8px;"></i>
            Last 7 Days — Created vs. Resolved
        </div>
        <canvas id="trendChart" style="max-height: 280px;"></canvas>
    </div>
</div>

<!-- Quick actions -->
<div style="margin-bottom: 28px;">
    <div class="accent-text" style="margin-bottom: 12px;">Quick Actions</div>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="@Url.Action("AllTickets", "Admin", new { view = "unassigned" })" class="btn-primary-gold">
            <i class="fa-solid fa-user-plus"></i> Assign Pending Tickets
        </a>
        <a href="@Url.Action("ManageUsers", "Admin")" class="btn-secondary-gold">
            <i class="fa-solid fa-users-gear"></i> Manage Users
        </a>
        <a href="@Url.Action("CreateTicket", "Admin")" class="btn-secondary-gold">
            <i class="fa-solid fa-circle-plus"></i> Raise Complaint
        </a>
    </div>
</div>

<!-- Recent tickets table -->
<div class="luxury-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <div style="font-weight: 700; color: var(--text-primary); font-size: 15px;">
            <i class="fa-solid fa-clock-rotate-left" style="color: var(--accent-primary); margin-right: 8px;"></i>
            Recently Raised Tickets
        </div>
        <a href="@Url.Action("AllTickets", "Admin")" style="font-size: 13px; color: var(--accent-primary); text-decoration: none; font-weight: 600;">
            View All <i class="fa-solid fa-arrow-right" style="font-size: 11px;"></i>
        </a>
    </div>

    @if (recentTickets != null && recentTickets.Any())
    {
        <table class="luxury-table">
            <thead>
                <tr>
                    <th>Ticket ID</th>
                    <th>Title</th>
                    <th>Raised By</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in recentTickets)
                {
                    string sc = t.StatusId == 1 ? "badge-status-open"
                              : t.StatusId == 2 ? "badge-status-inprogress"
                              : t.StatusId == 3 ? "badge-status-pending"
                              : "badge-status-closed";
                    string st = t.StatusId == 1 ? "Open"
                              : t.StatusId == 2 ? "In Progress"
                              : t.StatusId == 3 ? "In Review" : "Completed";
                    <tr>
                        <td style="font-weight: 700; color: var(--accent-primary); font-family: monospace;">TICK-@t.TicketId.ToString("D4")</td>
                        <td style="font-weight: 600; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@t.Title</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@t.RaisedByName</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@(string.IsNullOrEmpty(t.AssignedToName) ? "Unassigned" : t.AssignedToName)</td>
                        <td><span class="badge-pill-luxury @sc">@st</span></td>
                        <td style="text-align: right;">
                            <a href="@Url.Action("ManageTicket", "Admin", new { id = t.TicketId })"
                               class="btn-primary-gold" style="padding: 5px 12px; font-size: 11px;">
                                <i class="fa-solid fa-gear"></i> Handle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: var(--text-secondary);">
            <i class="fa-solid fa-inbox" style="font-size: 36px; color: var(--accent-primary); margin-bottom: 12px;"></i>
            <div>No tickets yet.</div>
        </div>
    }
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/Content/RequiredJs/Admin/Dashboard.js"></script>
}