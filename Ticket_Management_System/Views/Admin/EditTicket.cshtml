@model TicketModel.ViewModels.EditTicketAdminViewModel
@{
    ViewBag.Title = "Edit Ticket";
}

<a href="@Url.Action("AllTickets", "Admin")" class="back-link-btn">
    <i class="fa-solid fa-arrow-left"></i> Back to All Tickets
</a>

<h2>Edit Ticket</h2>

@using (Html.BeginForm("EditTicket", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TicketId)
    @Html.HiddenFor(m => m.PriorityId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Description)
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
    </div>

    <div class="form-group">
        <label>Status</label>
        <select name="StatusId" class="form-control">
            <option value="1" @(Model.StatusId == 1 ? "selected" : "")>To Do</option>
            <option value="2" @(Model.StatusId == 2 ? "selected" : "")>In Progress</option>
            <option value="4" @(Model.StatusId == 4 ? "selected" : "")>Completed</option>
        </select>
    </div>

    <button type="submit" class="btn-jira-create">Save Changes</button>
    <a href="@Url.Action("AllTickets")" class="btn btn-default">Cancel</a>
}