@{
    ViewBag.Title = "Reset Password - Simplify";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Reset Password - Simplify</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            var saved = localStorage.getItem('theme-preference');
            var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            var theme = saved || system || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body style="background: var(--bg-primary); margin: 0; padding: 0;">

    <!-- PRE-LOGIN HEADER (same as Login.cshtml) -->
    <header class="landing-header">
        <a href="@Url.Action("Index", "Home")" class="app-brand">
            <span class="logo-badge-sm">S</span> Simplify
        </a>
        <div style="display: flex; align-items: center; gap: 12px;">
            <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme" title="Toggle Dark/Light Theme">
                <i class="fa-solid fa-sun sun-icon"></i>
                <i class="fa-solid fa-moon moon-icon"></i>
            </button>
            <a href="@Url.Action("Login", "Account")" class="landing-btn-ghost">Login</a>
            <a href="@Url.Action("Register", "Account")" class="landing-btn-solid">Register</a>
        </div>
    </header>

    <div class="landing-split auth-page-enter">
        <!-- Left Decorative Brand Panel (same as Login.cshtml) -->
        <div class="landing-panel-left">
            <div style="display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: rgba(255,255,255,0.15); border-radius: 12px; margin-bottom: 8px;">
                <span style="font-size: 28px; font-weight: 800; color: #FFFFFF;">S</span>
            </div>

            <div style="font-size: 28px; font-weight: 700; color: #FFFFFF;">Simplify</div>
            <div style="font-size: 14px; color: rgba(255,255,255,0.75); margin-bottom: 24px;">Enterprise complaint &amp; ticket resolution</div>

            <div style="display: flex; flex-direction: column; gap: 10px; align-items: flex-start; text-align: left;">
                <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255,255,255,0.85);">
                    <i class="fa-solid fa-check" style="color: #FFFFFF;"></i> JWT secured authentication
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255,255,255,0.85);">
                    <i class="fa-solid fa-check" style="color: #FFFFFF;"></i> Role-based access control
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255,255,255,0.85);">
                    <i class="fa-solid fa-check" style="color: #FFFFFF;"></i> Real-time team notifications
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="landing-panel-right">
            <div class="auth-form-box">
                <h2 style="font-size: 24px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px 0;">Set a new password</h2>
                <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 24px;">Enter and confirm your new password below.</div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div style="background: rgba(239, 83, 80, 0.12); border: 1px solid var(--error); color: var(--error); padding: 12px 16px; border-radius: 6px; font-size: 13px; margin-bottom: 20px;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-bottom: 18px;">
                        <label>New Password</label>
                        <input type="password" name="newPassword" id="newPwd" class="form-control"
                               placeholder="Minimum 6 characters" required
                               style="margin-top: 6px;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 8px;">
                        <label>Confirm New Password</label>
                        <input type="password" name="confirmPassword" id="confPwd" class="form-control"
                               placeholder="Re-enter new password" required
                               style="margin-top: 6px;" />
                    </div>

                    <div id="matchMsg" style="font-size: 12px; margin-bottom: 20px; min-height: 18px;"></div>

                    <button type="submit" class="auth-btn-submit">
                        <i class="fa-solid fa-key" style="margin-right: 6px;"></i> Reset Password
                    </button>
                }

                <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle); font-size: 13px; color: var(--text-secondary);">
                    <a href="@Url.Action("Login", "Account")" style="color: var(--accent-primary); font-weight: 600; text-decoration: none;">Back to Login</a>
                </div>
            </div>
        </div>
    </div>

    <!-- PAGE NAVIGATION OVERLAY -->
    <div id="pageLoadingOverlay" class="loading-overlay">
        <div class="spinner-ring"></div>
        <div class="loading-text">Loading...</div>
    </div>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/app-ui.js"></script>
    <script src="~/Scripts/assistant-bot.js"></script>
    <script src="~/Content/RequiredJs/Account/ResetPassword.js"></script>
</body>
</html>
