@{
    ViewBag.Title = "Change Password";
    ViewBag.ActiveTab = "MyAccount";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">Account Security</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">Change Password</h2>
    </div>
    <a href="@Url.Action("Index", "MyAccount")" class="btn-secondary-gold">
        <i class="fa-solid fa-arrow-left"></i> Back to Profile
    </a>
</div>

<div class="luxury-card" style="max-width: 520px; padding: 32px;">
    <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
        <i class="fa-solid fa-lock" style="margin-right: 6px;"></i> Update Your Password
    </div>

    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group" style="margin-bottom: 20px;">
            <label style="font-size: 12px; color: var(--accent-primary); font-weight: 600; margin-bottom: 6px; display: block;">
                Current Password <span style="color: var(--error);">*</span>
            </label>
            <input type="password" name="currentPassword" class="form-control"
                   placeholder="Enter your current password" required />
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label style="font-size: 12px; color: var(--accent-primary); font-weight: 600; margin-bottom: 6px; display: block;">
                New Password <span style="color: var(--error);">*</span>
            </label>
            <input type="password" name="newPassword" id="newPassword" class="form-control"
                   placeholder="Minimum 6 characters" required />
        </div>

        <div class="form-group" style="margin-bottom: 28px;">
            <label style="font-size: 12px; color: var(--accent-primary); font-weight: 600; margin-bottom: 6px; display: block;">
                Confirm New Password <span style="color: var(--error);">*</span>
            </label>
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control"
                   placeholder="Re-enter new password" required />
            <div id="matchMsg" style="font-size: 12px; margin-top: 6px; min-height: 16px;"></div>
        </div>

        <div style="display: flex; gap: 12px; border-top: 1px solid var(--border-subtle); padding-top: 20px;">
            <button type="submit" class="btn-primary-gold">
                <i class="fa-solid fa-floppy-disk"></i> Save New Password
            </button>
            <a href="@Url.Action("Index", "MyAccount")" class="btn-secondary-gold">
                <i class="fa-solid fa-xmark"></i> Cancel
            </a>
        </div>
    }
</div>

@section scripts {
    <script src="~/Content/RequiredJs/Account/ChangePassword.js"></script>
}
