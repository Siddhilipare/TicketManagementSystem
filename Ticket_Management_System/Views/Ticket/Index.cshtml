@model IEnumerable<TicketModel.Models.TicketModel>
@using System.Linq
@{
    ViewBag.Title = "My Complaints";
    ViewBag.ActiveTab = "Tickets";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">Complaint Tracking</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">My Complaints</h2>
    </div>
    <a href="@Url.Action("Create", "Ticket")" class="btn-primary-gold">
        <i class="fa-solid fa-circle-plus"></i> Raise Complaint
    </a>
</div>

<!-- FILTER SEARCH BAR -->
<div class="luxury-card" style="padding: 20px; margin-bottom: 24px; position: relative; z-index: 100;">
    @using (Html.BeginForm("Index", "Ticket", FormMethod.Get, new { id = "ticketFilterForm", data_search = (ViewBag.Search ?? "").ToString(), data_date = (ViewBag.SelectedDate ?? "").ToString(), data_sort_order = (ViewBag.SortOrder ?? "newest").ToString(), data_status_filter = (ViewBag.StatusFilter != null ? ViewBag.StatusFilter.ToString() : ""), style = "display: flex; gap: 14px; align-items: center; flex-wrap: wrap;" }))
    {
        <div style="flex-grow: 1; min-width: 240px; position: relative;">
            <input type="text" name="search" id="searchInput" value="@ViewBag.Search" placeholder="Search by title, description..." class="form-control" />
        </div>

        <div class="dropdown" style="position: relative;">
            <button type="button" class="btn-secondary-gold dropdown-toggle" data-toggle="dropdown" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px;" title="Filter Options">
                <i class="fa-solid fa-filter" style="font-size: 16px; color: var(--accent-primary);"></i>
                <span>Filter</span>
                <i class="fa-solid fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>  
            </button>

            <div class="dropdown-menu dropdown-menu-right funnel-filter-panel" onclick="event.stopPropagation();">
                <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                    <span><i class="fa-solid fa-filter" style="margin-right: 4px;"></i> Funnel Filter</span>
                    <span style="font-size: 10px; color: var(--text-secondary); font-weight: normal;">Refine Complaints</span>
                </div>

                <!-- Status Filter -->
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-circle-half-stroke" style="margin-right: 4px;"></i> Filter by Status
                    </label>
                    <select name="statusFilter" id="statusFilter" class="form-control" style="font-size: 13px;">
                        <option value="">All Statuses</option>
                        <option value="1" @(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == 1 ? "selected" : "")>Open (To Do)</option>
                        <option value="2" @(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == 2 ? "selected" : "")>In Progress</option>
                        <option value="4" @(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == 4 ? "selected" : "")>Completed</option>
                    </select>
                </div>

                <!-- Date & Sort -->
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-calendar-days" style="margin-right: 4px;"></i> Date Order
                    </label>
                    <select name="sortOrder" id="sortOrder" class="form-control" style="margin-bottom: 10px; font-size: 13px;">
                        <option value="newest" @(ViewBag.SortOrder == "oldest" ? "" : "selected")>1. Newest to Oldest</option>
                        <option value="oldest" @(ViewBag.SortOrder == "oldest" ? "selected" : "")>2. Oldest to Newest</option>
                    </select>
                    <label class="form-label" style="font-size: 11px; margin-bottom: 4px; color: var(--text-secondary);">Specific Created Date</label>
                    <input type="date" name="date" id="dateFilter" value="@ViewBag.SelectedDate" class="form-control" style="font-size: 13px;" />
                </div>

                <div style="display: flex; gap: 10px; margin-top: 14px;">
                    <button type="submit" class="btn-primary-gold" style="flex: 1; padding: 6px 0; font-size: 12px;" onclick="clearState()">
                        <i class="fa-solid fa-check"></i> Apply
                    </button>
                    <a href="@Url.Action("Index", "Ticket")" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px; border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearState()">
                        Reset
                    </a>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary-gold" onclick="clearState()"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        <a href="@Url.Action("Index", "Ticket")" class="btn-secondary-gold" style="border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearState()">
            <i class="fa-solid fa-rotate-left"></i> Reset
        </a>
    }
</div>

<div class="luxury-table-wrapper">
    @if (Model != null && Model.Any())
    {
        <table class="luxury-table" id="ticketsTable">
            <thead>
                <tr>
                    <th>Ticket ID</th>
                    <th>Complaint Title</th>
                    <th>Created On</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="ticketsBody">
                @foreach (var item in Model)
                {
                    string statusClass = item.StatusId == 1 ? "badge-status-open"
                                       : item.StatusId == 2 ? "badge-status-inprogress"
                                       : item.StatusId == 3 ? "badge-status-pending"
                                       : item.StatusId == 4 ? "badge-status-closed" : "badge-status-onhold";
                    string statusText = item.StatusId == 1 ? "Open"
                                      : item.StatusId == 2 ? "In Progress"
                                      : item.StatusId == 3 ? "In Review"
                                      : item.StatusId == 4 ? "Completed" : "Unknown";

                    <tr class="ticket-row" style="display:none;">
                        <td style="font-weight: 700; color: var(--accent-primary); font-family: monospace;">TICK-@item.TicketId.ToString("D4")</td>
                        <td style="font-weight: 600;">@item.Title</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@item.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>
                            <span class="badge-pill-luxury @statusClass">@statusText</span>
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 8px;">
                                <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })"
                                   class="btn-primary-gold" style="padding: 6px 14px; font-size: 12px;"
                                   onclick="saveState()" title="View Details">
                                    <i class="fa-solid fa-eye"></i> 
                                </a>
                                @if (item.StatusId == 1)
                                {
                                    <a href="@Url.Action("Edit", "Ticket", new { id = item.TicketId })"
                                       class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px;"
                                       onclick="saveState()" title="Edit Complaint">
                                        <i class="fa-solid fa-pen"></i> 
                                    </a>
                                    <button type="button"
                                            class="btn-secondary-gold open-delete-btn"
                                            style="padding: 6px 12px; font-size: 12px; border-color: var(--error); color: var(--error);"
                                            data-ticket-id="@item.TicketId"
                                            data-title="@item.Title"
                                            data-status="@statusText"
                                            data-date="@item.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")"
                                            title="Delete Complaint">
                                        <i class="fa-solid fa-trash"></i> 
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="paginationBar" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap;"></div>
        <div id="pageInfo" style="text-align: center; font-size: 12px; color: var(--text-tertiary); margin-top: 8px;"></div>
    }
    else
    {
        <div style="padding: 48px; text-align: center; color: var(--text-secondary);">
            <i class="fa-solid fa-folder-open" style="font-size: 48px; color: var(--accent-primary); margin-bottom: 16px;"></i>
            <h3 style="color: var(--text-primary);">No complaints found</h3>
            <p>You haven't raised any complaints matching your criteria yet.</p>
            <a href="@Url.Action("Create", "Ticket")" class="btn-primary-gold" style="margin-top: 12px;">Raise Your First Complaint</a>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div class="luxury-card" style="max-width:460px; width:90%; margin:0 auto; padding:36px; position:relative;">
        <div style="margin-bottom:20px;">
            <div class="accent-text" style="color:var(--error);">Are You Sure?</div>
            <h3 class="luxury-heading" style="font-size:22px; margin-top:4px; margin-bottom:0;">Delete Complaint</h3>
        </div>
        <div style="background:var(--bg-primary); border:1px solid var(--border-subtle); border-radius:10px; padding:16px; margin-bottom:20px;">
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Ticket ID</div>
                <div style="font-weight:700; color:var(--accent-primary); font-family:monospace;" id="del-id"></div>
            </div>
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Title</div>
                <div style="font-weight:600; color:var(--text-primary);" id="del-title"></div>
            </div>
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Status</div>
                <div style="color:var(--text-secondary);" id="del-status"></div>
            </div>
            <div>
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Raised On</div>
                <div style="color:var(--text-secondary);" id="del-date"></div>
            </div>
        </div>
        <p style="font-size:13px; color:var(--text-secondary); margin-bottom:24px;">
            This action is <strong>permanent</strong> and cannot be undone. All attachments and comments will also be removed.
        </p>
        <div style="display:flex; gap:12px;">
            @using (Html.BeginForm("Delete", "Ticket", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteTicketId" />
                <button type="submit" class="btn-primary-gold" style="flex:1; background:var(--error); border-color:var(--error);">
                    <i class="fa-solid fa-trash"></i> Yes, Delete
                </button>
            }
            <button type="button" class="btn-secondary-gold" style="flex:1;" onclick="closeDeleteModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/RequiredJs/Ticket/Index.js"></script>
}
