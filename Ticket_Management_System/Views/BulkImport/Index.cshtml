@{
    ViewBag.Title = "Bulk Add Complaints";
    ViewBag.ActiveTab = "BulkImport";
}

<div style="margin-bottom: 28px;">
    <div class="accent-text">Bulk Import</div>
    <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">Bulk Add Complaints</h2>
</div>

<div class="luxury-card" style="padding: 24px; margin-bottom: 24px;">
    <div style="font-weight: 700; color: var(--text-primary); font-size: 15px; margin-bottom: 12px;">
        <i class="fa-solid fa-circle-info" style="color: var(--accent-primary); margin-right: 8px;"></i>
        How it works
    </div>
    <ol style="font-size: 13px; color: var(--text-secondary); line-height: 1.9; padding-left: 20px; margin: 0;">
        <li>Download the Excel template below and fill in one row per complaint.</li>
        <li><strong>Title</strong> (3–100 characters) and <strong>Description</strong> (10–2000 characters) are both required.</li>
        <li>Up to 200 rows per import. New complaints are created unassigned, ready for an Admin to assign.</li>
        <li>You'll get a results summary showing exactly which rows succeeded and which failed, with reasons.</li>
    </ol>
    <a href="@Url.Action("DownloadTemplate", "BulkImport")" class="btn-secondary-gold" style="margin-top: 16px; display: inline-flex;">
        <i class="fa-solid fa-file-arrow-down"></i> Download Excel Template
    </a>
</div>

<div class="luxury-card" style="padding: 24px; max-width: 640px;">
    @using (Html.BeginForm("Upload", "BulkImport", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Complaint Sheet (.xlsx)</label>
            <input type="file" name="bulkFile" class="form-control" accept=".xlsx" required />
        </div>

        <button type="submit" class="btn-primary-gold" style="margin-top: 20px;">
            <i class="fa-solid fa-upload"></i> Upload &amp; Create Complaints
        </button>
    }
</div>