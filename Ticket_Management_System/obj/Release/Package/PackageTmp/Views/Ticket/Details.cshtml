@model TicketModel.Models.TicketModel
@using System.Linq
@{
    ViewBag.Title = "Complaint Details";
    ViewBag.ActiveTab = "Tickets";
    var comments = ViewBag.Comments as List<TicketModel.Models.TicketCommentModel>;
    var attachments = ViewBag.Attachments as List<TicketModel.Models.TicketAttachmentModel>;

    string statusClass = Model.StatusId == 1 ? "badge-status-open"
                       : Model.StatusId == 2 ? "badge-status-inprogress"
                       : Model.StatusId == 3 ? "badge-status-pending"
                       : Model.StatusId == 4 ? "badge-status-closed" : "badge-status-onhold";
    string statusText = Model.StatusId == 1 ? "Open"
                      : Model.StatusId == 2 ? "In Progress"
                      : Model.StatusId == 3 ? "In Review"
                      : Model.StatusId == 4 ? "Completed" : "Unknown";
    bool isArchived = Model.StatusId == 4 && Model.TicketClosedDate.HasValue
                      && (DateTime.Now - Model.TicketClosedDate.Value).TotalMinutes >= 30;
}

<div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
    <a href="@Url.Action("Index", "Ticket")" class="back-link-btn" style="margin-bottom: 0;">
        <i class="fa-solid fa-arrow-left"></i> Back to My Complaints
    </a>
    @if (Model.StatusId == 1)
    {
        <a href="@Url.Action("Edit", "Ticket", new { id = Model.TicketId })" class="btn-secondary-gold" style="padding: 8px 18px; font-size: 13px;">
            <i class="fa-solid fa-pen"></i> Edit Complaint
        </a>
    }
</div>

<!-- Header Ticket Status Banner -->
<div class="luxury-hero" style="padding: 28px 36px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
            <span style="font-family: monospace; font-size: 14px; font-weight: 700; color: var(--accent-primary);">TICK-@Model.TicketId.ToString("D4")</span>
            <span class="badge-pill-luxury @statusClass">@statusText</span>
        </div>
        <h2 class="luxury-heading" style="font-size: 28px; margin: 0;">@Model.Title</h2>
        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 6px;">
            Raised on @Model.CreatedOn.ToString("MMMM dd, yyyy \a\\t hh:mm tt")
        </div>
    </div>
</div>

<div class="row" style="display: flex; gap: 24px; flex-wrap: wrap;">
    <div style="flex: 2; min-width: 320px;">
        <!-- Description -->
        <div class="luxury-card">
            <h4 style="color: var(--accent-primary); border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
                <i class="fa-solid fa-align-left" style="margin-right: 8px;"></i> Complaint Description
            </h4>
            <p style="font-size: 15px; color: var(--text-primary); line-height: 1.7; white-space: pre-wrap;">@Model.Description</p>
        </div>

        <!-- Attachments -->
        <div class="luxury-card">
            <h4 style="color: var(--accent-primary); border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
                <i class="fa-solid fa-paperclip" style="margin-right: 8px;"></i> Attachments
            </h4>
            @if (attachments != null && attachments.Any())
            {
                <div class="attachment-grid">
                    @foreach (var a in attachments)
                    {
                        string ext = System.IO.Path.GetExtension(a.FilePath).TrimStart('.').ToLower();
                        bool isImage = ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "gif" || ext == "bmp";
                        string iconClass = ext == "pdf" ? "fa-file-pdf" : (ext == "doc" || ext == "docx") ? "fa-file-word" : ext == "txt" ? "fa-file-lines" : "fa-file";
                        string fileName = System.IO.Path.GetFileName(a.FilePath);

                        <div class="attachment-card" title="@fileName">
                            @if (isImage)
                            {
                                <a href="@a.FilePath" target="_blank" style="width: 100%; height: 100%;">
                                    <img src="@a.FilePath" alt="@fileName" />
                                </a>
                            }
                            else
                            {
                                <a href="@a.FilePath" target="_blank" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; width: 100%; height: 100%; padding: 8px;">
                                    <i class="fa-solid @iconClass file-icon"></i>
                                    <span class="file-name">@fileName</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: var(--text-tertiary); font-style: italic;">No files attached to this complaint.</p>
            }

            @if (!isArchived && Model.StatusId != 1)
            {
                <div style="margin-top: 24px; padding-top: 20px; border-top: 1px dashed var(--border-subtle);">
                    <label class="form-label">Upload Additional Document</label>
                    @using (Html.BeginForm("AddAttachment", "Ticket", FormMethod.Post, new { enctype = "multipart/form-data", style = "display: flex; gap: 12px; align-items: center;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="file" name="file" class="form-control" style="flex-grow: 1;" />
                        <button type="submit" class="btn-secondary-gold"><i class="fa-solid fa-upload"></i> Upload</button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Conversation & Comments Section -->
    <div style="flex: 3; min-width: 340px;">
        <div class="luxury-card">
            <h4 style="color: var(--accent-primary); border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 20px;">
                <i class="fa-solid fa-comments" style="margin-right: 8px;"></i> Activity & Discussion
            </h4>

            @{
                int currentUserId = ((System.Security.Claims.ClaimsPrincipal)User).FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub) != null
                    ? Convert.ToInt32(((System.Security.Claims.ClaimsPrincipal)User).FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub).Value)
                    : 0;
            }

            <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; max-height: 480px; overflow-y: auto; padding-right: 6px;">
                @if (comments != null && comments.Any())
                {
                    foreach (var c in comments)
                    {
                        bool isMine = c.CommentedbyUserId == currentUserId;
                        string text = c.CommentText ?? "";

                        System.Text.RegularExpressions.Match imgMatch = System.Text.RegularExpressions.Regex.Match(text, @"\[IMAGE:(.*?)\]");
                        System.Text.RegularExpressions.Match fileMatch = System.Text.RegularExpressions.Regex.Match(text, @"\[FILE:(.*?)\|(.*?)\]");

                        string cleanText = text;
                        if (imgMatch.Success) { cleanText = cleanText.Replace(imgMatch.Value, "").Trim(); }
                        if (fileMatch.Success) { cleanText = cleanText.Replace(fileMatch.Value, "").Trim(); }

                        <div style="background: var(--bg-tertiary); border-left: 4px solid @(isMine ? "var(--accent-primary)" : "var(--info)"); border-radius: 6px; padding: 14px 18px; margin-left: @(isMine ? "24px" : "0"); margin-right: @(isMine ? "0" : "24px");">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <strong style="color: var(--text-primary); font-size: 13px;">@c.CommentedByName</strong>
                                <span style="font-size: 11px; color: var(--text-tertiary);">@c.CreatedOn.ToString("MMM dd, hh:mm tt")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(cleanText))
                            {
                                <div style="font-size: 14px; color: var(--text-secondary); line-height: 1.5; word-break: break-word;">@cleanText</div>
                            }

                            @if (imgMatch.Success)
                            {
                                string imgUrl = imgMatch.Groups[1].Value;
                                <div style="margin-top: 8px;">
                                    <a href="@imgUrl" target="_blank" style="display: inline-block;">
                                        <img src="@imgUrl" style="max-width: 240px; max-height: 180px; border-radius: 8px; border: 1.5px solid var(--border-color); object-fit: cover;" />
                                    </a>
                                </div>
                            }

                            @if (fileMatch.Success)
                            {
                                string fileUrl = fileMatch.Groups[1].Value;
                                string fileName = fileMatch.Groups[2].Value;
                                string ext = System.IO.Path.GetExtension(fileUrl).TrimStart('.').ToLower();
                                string iconClass = ext == "pdf" ? "fa-file-pdf" : (ext == "doc" || ext == "docx") ? "fa-file-word" : ext == "txt" ? "fa-file-lines" : "fa-file";

                                <div style="margin-top: 8px;">
                                    <a href="@fileUrl" target="_blank" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px; display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                                        <i class="fa-solid @iconClass" style="font-size: 16px;"></i> <span>@fileName</span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 32px; color: var(--text-tertiary);">
                        <i class="fa-regular fa-comment-dots" style="font-size: 36px; margin-bottom: 8px; color: var(--accent-primary);"></i>
                        <p>No messages yet. Start the conversation below.</p>
                    </div>
                }
            </div>

            @if (!isArchived && Model.StatusId != 1)
            {
                using (Html.BeginForm("AddComment", "Ticket", FormMethod.Post, new { enctype = "multipart/form-data", style = "display: flex; flex-direction: column; gap: 8px;" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@Model.TicketId" />

                    <div style="display: flex; gap: 10px; align-items: center; position: relative;">
                        <div style="flex-grow: 1; position: relative; display: flex; align-items: center;">
                            <input type="text" name="commentText" id="empChatCommentText" class="form-control" placeholder="Type a message..." style="height: 46px; font-size: 14px; padding-right: 48px;" />

                            <input type="file" id="empChatFileInput" name="chatFile" style="position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; z-index: -1;" onchange="handleEmpChatFileSelect(this)" />

                            <label for="empChatFileInput" title="Attach File (PDF, Word, Excel, Images)" style="position: absolute; right: 14px; margin: 0; cursor: pointer; color: var(--accent-primary); font-size: 20px; transition: transform 0.15s ease; z-index: 5;">
                                <i class="fa-solid fa-paperclip"></i>
                            </label>
                        </div>

                        <button type="submit" class="btn-primary-gold" style="padding: 10px 24px; font-size: 13px; height: 46px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;">
                            <i class="fa-solid fa-paper-plane"></i> Send
                        </button>
                    </div>

                    <!-- Selected Attachment Preview Badge -->
                    <div id="empChatFilePreviewBadge" style="display: none; align-items: center; gap: 8px; background: var(--bg-tertiary); border: 1px solid var(--accent-primary); padding: 6px 12px; border-radius: 6px; width: fit-content; font-size: 12px; color: var(--accent-primary); font-weight: 600;">
                        <i class="fa-solid fa-paperclip"></i> <span id="empChatFilePreviewName"></span>
                        <button type="button" onclick="removeEmpChatFileSelect()" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 16px; margin-left: 4px; line-height: 1;">&times;</button>
                    </div>
                }
            }
        </div>
    </div>

    <script>
    function handleEmpChatFileSelect(input) {
        if (input.files && input.files[0]) {
            document.getElementById('empChatFilePreviewName').textContent = input.files[0].name;
            document.getElementById('empChatFilePreviewBadge').style.display = 'inline-flex';
        }
    }
    function removeEmpChatFileSelect() {
        var input = document.getElementById('empChatFileInput');
        input.value = '';
        document.getElementById('empChatFilePreviewBadge').style.display = 'none';
    }
    </script>
</div>