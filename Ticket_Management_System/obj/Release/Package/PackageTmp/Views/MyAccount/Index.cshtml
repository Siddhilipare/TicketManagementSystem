@model TicketModel.UserDetailModel
@{
    ViewBag.Title = "My Account";
    ViewBag.ActiveTab = "MyAccount";
    string initials = (!string.IsNullOrEmpty(Model.UserName))
        ? Model.UserName.Trim().Substring(0, 1).ToUpper()
        : (ViewBag.Email != null ? ViewBag.Email.ToString().Substring(0, 1).ToUpper() : "U");
}



<!-- Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">Account Settings</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">My Account</h2>
    </div>
   
</div>

<!-- Avatar + name card -->
<div class="luxury-card" style="padding: 28px; margin-bottom: 24px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
    <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--accent-primary); display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; color: #fff; flex-shrink: 0;">
        @initials
    </div>
    <div>
        <div style="font-size: 22px; font-weight: 700; color: var(--text-primary);">@Model.UserName</div>
        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">@ViewBag.Email</div>
        <span class="badge-pill-luxury badge-status-inprogress" style="margin-top: 8px; display: inline-block;">@ViewBag.RoleName</span>
    </div>
</div>

<!-- Profile details -->
<div class="luxury-card" style="padding: 28px;">
    <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
        <i class="fa-solid fa-user" style="margin-right: 6px;"></i> Profile Information
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px;">

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">Full Name</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">
                @(string.IsNullOrWhiteSpace(Model.UserName) ? "—" : Model.UserName)
            </div>
        </div>

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">Email</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">@ViewBag.Email</div>
        </div>

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">Gender</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">
                @(string.IsNullOrWhiteSpace(Model.Gender) ? "—" : Model.Gender)
            </div>
        </div>

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">Age</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">
                @(Model.Age.HasValue ? Model.Age.Value.ToString() : "—")
            </div>
        </div>

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">City</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">
                @(string.IsNullOrWhiteSpace(Model.City) ? "—" : Model.City)
            </div>
        </div>

        <div>
            <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">Address</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 15px;">
                @(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)
            </div>
        </div>

    </div>

    <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-subtle);">
        <a href="@Url.Action("Edit", "MyAccount")" class="btn-secondary-gold">
            <i class="fa-solid fa-pencil"></i> Edit Profile
        </a>

        <a href="@Url.Action("ChangePassword", "Account")" class="btn-secondary-gold">
            <i class="fa-solid fa-key"></i> Change Password
        </a>
    </div>
</div>
