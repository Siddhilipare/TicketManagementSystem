@model TicketModel.UserDetailModel
@{
    ViewBag.Title = "Edit Profile";
    ViewBag.ActiveTab = "MyAccount";
}

<!-- Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">Account Settings</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">Edit Profile</h2>
    </div>
    <a href="@Url.Action("Index", "MyAccount")" class="btn-secondary-gold">
        <i class="fa-solid fa-arrow-left"></i> Back to Profile
    </a>
</div>

<div class="luxury-card" style="padding: 28px; max-width: 680px;">
    <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
        <i class="fa-solid fa-pen" style="margin-right: 6px;"></i> Update Your Information
    </div>

    <!-- Email display-only -->
    <div style="margin-bottom: 20px;">
        <label class="form-label" style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">Email (cannot be changed)</label>
        <div style="padding: 10px 14px; background: var(--bg-tertiary); border: 1px solid var(--border-subtle); border-radius: 6px; font-size: 14px; color: var(--text-secondary);">
            @ViewBag.Email
        </div>
    </div>

    @using (Html.BeginForm("Edit", "MyAccount", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.HiddenFor(m => m.UserDetailId)

        <!-- Validation summary -->
        if (!ViewData.ModelState.IsValid)
        {
            <div style="background: rgba(239,83,80,0.12); border: 1px solid var(--error); color: var(--error); padding: 12px 16px; border-radius: 6px; font-size: 13px; margin-bottom: 20px;">
                <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i>
                @Html.ValidationSummary(false, "", new { @style = "margin: 0; padding: 0; list-style: none;" })
            </div>
        }

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">

            <!-- Full Name -->
            <div style="grid-column: span 2;">
                <label class="form-label" style="font-size: 12px; color: var(--accent-primary); margin-bottom: 4px;">
                    <i class="fa-solid fa-user" style="margin-right: 4px;"></i> Full Name <span style="color: var(--error);">*</span>
                </label>
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "e.g. Siddhi Lipare" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @style = "color: var(--error); font-size: 12px;" })
            </div>

            <!-- Gender -->
            <div>
                <label class="form-label" style="font-size: 12px; color: var(--accent-primary); margin-bottom: 4px;">
                    <i class="fa-solid fa-venus-mars" style="margin-right: 4px;"></i> Gender
                </label>
                @Html.DropDownListFor(m => m.Gender,
                    new SelectList(new[] {
                        new { Value = "", Text = "Select gender..." },
                        new { Value = "Male", Text = "Male" },
                        new { Value = "Female", Text = "Female" },
                        new { Value = "Other", Text = "Other" }
                    }, "Value", "Text", Model.Gender),
                    new { @class = "form-control" })
            </div>

            <!-- Age -->
            <div>
                <label class="form-label" style="font-size: 12px; color: var(--accent-primary); margin-bottom: 4px;">
                    <i class="fa-solid fa-calendar" style="margin-right: 4px;"></i> Age
                </label>
                @Html.TextBoxFor(m => m.Age, new { @class = "form-control", placeholder = "e.g. 25", type = "number", min = "16", max = "100" })
                @Html.ValidationMessageFor(m => m.Age, "", new { @style = "color: var(--error); font-size: 12px;" })
            </div>

            <!-- City -->
            <div>
                <label class="form-label" style="font-size: 12px; color: var(--accent-primary); margin-bottom: 4px;">
                    <i class="fa-solid fa-city" style="margin-right: 4px;"></i> City
                </label>
                @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "e.g. Pune" })
            </div>

            <!-- Address -->
            <div>
                <label class="form-label" style="font-size: 12px; color: var(--accent-primary); margin-bottom: 4px;">
                    <i class="fa-solid fa-location-dot" style="margin-right: 4px;"></i> Address
                </label>
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "e.g. MG Road" })
            </div>

        </div>

        <div style="display: flex; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-subtle);">
            <button type="submit" class="btn-primary-gold">
                <i class="fa-solid fa-floppy-disk"></i> Save Changes
            </button>
            <a href="@Url.Action("Index", "MyAccount")" class="btn-secondary-gold">
                <i class="fa-solid fa-xmark"></i> Cancel
            </a>
        </div>
    }
</div>
