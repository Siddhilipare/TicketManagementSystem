@model IEnumerable<TicketModel.Models.TicketModel>
@using System.Linq
@{
    ViewBag.Title = "My Complaints";
    ViewBag.ActiveTab = "AdminMyComplaints";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">My Complaint Tracking</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">My Complaints</h2>
    </div>
    <a href="@Url.Action("CreateTicket", "Admin")" class="btn-primary-gold">
        <i class="fa-solid fa-circle-plus"></i> Raise Complaint
    </a>
</div>

@using (Html.BeginForm("MyComplaints", "Admin", FormMethod.Get, new { style = "display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 24px;" }))
{
    <div style="flex-grow: 1; min-width: 240px;">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by title or ID..." class="form-control" />
    </div>
    <select name="sortOrder" class="form-control" style="width: auto;">
        <option value="newest" @(ViewBag.SortOrder == "oldest" ? "" : "selected")>Newest First</option>
        <option value="oldest" @(ViewBag.SortOrder == "oldest" ? "selected" : "")>Oldest First</option>
    </select>
    <button type="submit" class="btn-primary-gold"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
    <a href="@Url.Action("MyComplaints", "Admin")" class="btn-secondary-gold" style="border-color: var(--border-subtle); color: var(--text-secondary);"><i class="fa-solid fa-rotate-left"></i> Reset</a>
}

<div class="luxury-table-wrapper">
    @if (Model != null && Model.Any())
    {
        <table class="luxury-table">
            <thead>
                <tr>
                    <th>Ticket ID</th>
                    <th>Complaint Title</th>
                    <th>Created On</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string statusClass = item.StatusId == 1 ? "badge-status-open"
                                       : item.StatusId == 2 ? "badge-status-inprogress"
                                       : item.StatusId == 3 ? "badge-status-pending"
                                       : item.StatusId == 4 ? "badge-status-closed" : "badge-status-onhold";
                    string statusText = item.StatusId == 1 ? "Open"
                                      : item.StatusId == 2 ? "In Progress"
                                      : item.StatusId == 3 ? "On Hold"
                                      : item.StatusId == 4 ? "Closed" : "Unknown";

                    <tr>
                        <td style="font-weight: 700; color: var(--accent-primary); font-family: monospace;">TICK-@item.TicketId.ToString("D4")</td>
                        <td style="font-weight: 600;">@item.Title</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@item.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td><span class="badge-pill-luxury @statusClass">@statusText</span></td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 8px;">
                                <a href="@Url.Action("AdminTicketDetails", "Admin", new { id = item.TicketId })" class="btn-primary-gold" style="padding: 6px 14px; font-size: 12px;">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                                @if (item.StatusId == 1)
                                {
                                    <a href="@Url.Action("AdminTicketEdit", "Admin", new { id = item.TicketId })" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px;">
                                        <i class="fa-solid fa-pen"></i> Edit
                                    </a>
                                    <button type="button" class="btn-secondary-gold"
                                            style="padding: 6px 12px; font-size: 12px; border-color: var(--error); color: var(--error);"
                                            onclick="openDeleteModal(@item.TicketId, '@Html.Raw(item.Title.Replace("'", "\\'"))', '@statusText', '@item.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")')"
                                            title="Delete Complaint">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 48px; text-align: center; color: var(--text-secondary);">
            <i class="fa-solid fa-folder-open" style="font-size: 48px; color: var(--accent-primary); margin-bottom: 16px;"></i>
            <h3 style="color: var(--text-primary);">No complaints found</h3>
            <a href="@Url.Action("CreateTicket", "Admin")" class="btn-primary-gold" style="margin-top: 12px;">Raise Your First Complaint</a>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div class="luxury-card" style="max-width:460px; width:90%; margin:0 auto; padding:36px;">
        <div style="margin-bottom:20px;">
            <div class="accent-text" style="color:var(--error);">Danger Zone</div>
            <h3 class="luxury-heading" style="font-size:22px; margin-top:4px; margin-bottom:0;">Delete Complaint</h3>
        </div>
        <div style="background:var(--bg-primary); border:1px solid var(--border-subtle); border-radius:10px; padding:16px; margin-bottom:20px;">
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Ticket ID</div>
                <div style="font-weight:700; color:var(--accent-primary); font-family:monospace;" id="del-id"></div>
            </div>
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Title</div>
                <div style="font-weight:600; color:var(--text-primary);" id="del-title"></div>
            </div>
            <div style="margin-bottom:10px;">
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Status</div>
                <div style="color:var(--text-secondary);" id="del-status"></div>
            </div>
            <div>
                <div style="font-size:11px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.05em;">Raised On</div>
                <div style="color:var(--text-secondary);" id="del-date"></div>
            </div>
        </div>
        <p style="font-size:13px; color:var(--text-secondary); margin-bottom:24px;">This action is <strong>permanent</strong> and cannot be undone.</p>
        <div style="display:flex; gap:12px;">
            @using (Html.BeginForm("AdminDeleteMyTicket", "Admin", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteTicketId" />
                <button type="submit" class="btn-primary-gold" style="flex:1; background:var(--error); border-color:var(--error);">
                    <i class="fa-solid fa-trash"></i> Yes, Delete
                </button>
            }
            <button type="button" class="btn-secondary-gold" style="flex:1;" onclick="closeDeleteModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function openDeleteModal(id, title, status, date) {
            document.getElementById('del-id').textContent = 'TICK-' + String(id).padStart(4, '0');
            document.getElementById('del-title').textContent = title;
            document.getElementById('del-status').textContent = status;
            document.getElementById('del-date').textContent = date;
            document.getElementById('deleteTicketId').value = id;
            document.getElementById('deleteForm').action = '/Admin/AdminDeleteMyTicket/' + id;
            document.getElementById('deleteModal').style.display = 'flex';
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
        }
        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
    </script>
}