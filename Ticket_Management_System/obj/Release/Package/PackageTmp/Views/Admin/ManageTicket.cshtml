@model TicketModel.Models.TicketModel
@using System.Linq
@{
    ViewBag.Title = "Handle Ticket";
    ViewBag.ActiveTab = "AdminTickets";
    var supportList = ViewBag.SupportExecutives as List<TicketModel.Models.UserListModel>;
    var attachments = ViewBag.Attachments as List<TicketModel.Models.TicketAttachmentModel>;
    var comments = ViewBag.Comments as List<TicketModel.Models.TicketCommentModel>;
}

<div style="margin-bottom: 20px;">
    <a href="@Url.Action("AllTickets", "Admin")" class="back-link-btn">
        <i class="fa-solid fa-arrow-left"></i> Back to All Tickets
    </a>
</div>

<div class="luxury-card" style="max-width: 860px; margin: 0 auto; padding: 40px;">

    <!-- Ticket Header -->
    <div style="margin-bottom: 28px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
        <div class="accent-text" style="margin-bottom: 6px;">
            TICK-@Model.TicketId.ToString("D4") &bull; Raised by @Model.RaisedByName &bull; @Model.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")
        </div>
        <h2 class="luxury-heading" style="font-size: 26px; margin: 0;">@Model.Title</h2>
    </div>

    <!-- Description -->
    <div style="margin-bottom: 28px;">
        <div class="accent-text" style="margin-bottom: 8px;">Description</div>
        <div style="font-size: 14px; color: var(--text-secondary); line-height: 1.75; background: var(--bg-primary); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 16px;">
            @Model.Description
        </div>
    </div>

    <!-- Attachments -->
    <div style="margin-bottom: 28px;">
        <div class="accent-text" style="margin-bottom: 8px;">Attachments</div>
        @if (attachments != null && attachments.Any())
        {
            <div class="attachment-grid">
                @foreach (var a in attachments)
                {
                    string ext = System.IO.Path.GetExtension(a.FilePath).TrimStart('.').ToLower();
                    bool isImage = ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "gif" || ext == "bmp";
                    string iconClass = ext == "pdf" ? "fa-file-pdf" : (ext == "doc" || ext == "docx") ? "fa-file-word" : ext == "txt" ? "fa-file-lines" : "fa-file";
                    string fileName = System.IO.Path.GetFileName(a.FilePath);

                    <div class="attachment-card" title="@fileName">
                        @if (isImage)
                        {
                            <a href="@a.FilePath" target="_blank" style="width: 100%; height: 100%;">
                                <img src="@a.FilePath" alt="@fileName" />
                            </a>
                        }
                        else
                        {
                            <a href="@a.FilePath" target="_blank" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; width: 100%; height: 100%; padding: 8px;">
                                <i class="fa-solid @iconClass file-icon"></i>
                                <span class="file-name">@fileName</span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div style="font-size: 13px; color: var(--text-tertiary); font-style: italic;">No attachments</div>
        }
    </div>

    <!-- Single combined form: Assign Support Executive + Optional Comment -->
    @using (Html.BeginForm("ManageTicket", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="ticketId" value="@Model.TicketId" />

        <!-- Assign Support Executive -->
        <div style="margin-bottom: 28px; border-top: 1px solid var(--border-subtle); padding-top: 24px;">
            <div class="accent-text" style="margin-bottom: 8px;">Assign to Support Executive</div>
            <div class="form-group" style="margin-bottom: 0;">
                <select name="assignedToUserId" class="form-control" required>
                    <option value="">-- Select Support Executive --</option>
                    @if (supportList != null)
                    {
                        foreach (var s in supportList)
                        {
                            <option value="@s.UserId" @(s.UserId == Model.AssignedtoUserId ? "selected" : "")>@s.UserName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Conversation History -->
        <div style="border-top: 1px solid var(--border-subtle); padding-top: 24px;">
            <div class="accent-text" style="margin-bottom: 16px;">Conversation History</div>
            <div class="chat-thread" style="max-height: 400px; overflow-y: auto; margin-bottom: 24px; padding-right: 4px;">
                @if (comments != null && comments.Any())
                {
                    foreach (var c in comments)
                    {
                        <div class="chat-row chat-row-theirs">
                            <div class="chat-bubble chat-bubble-theirs">
                                <div class="chat-sender">@c.CommentedByName</div>
                                <div class="chat-text">@c.CommentText</div>
                                <div class="chat-time">@c.CreatedOn.ToString("MMM dd, hh:mm tt")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="font-size: 13px; color: var(--text-tertiary); font-style: italic; padding: 16px 0;">No comments yet. Start the conversation below.</div>
                }
            </div>

            <!-- Optional Comment Input -->
            <div style="border-top: 1px solid var(--border-subtle); padding-top: 20px;">
                <div class="accent-text" style="margin-bottom: 12px;">Add a Comment <span style="font-weight:400; text-transform:none; letter-spacing:0; color:var(--text-tertiary);">(optional)</span></div>
                <input type="text" name="commentText" class="form-control"
                       placeholder="Type a message to the employee or support executive... (optional)"
                       style="width: 100%; height: 44px; font-size: 14px;" />
            </div>
        </div>

        <!-- Single Save button: assigns AND sends the comment (if any) together -->
        <div style="display: flex; justify-content: center; border-top: 1px solid var(--border-subtle); padding-top: 24px; margin-top: 24px;">
            <button type="submit" class="btn-primary-gold" style="padding: 12px 40px;">
                <i class="fa-solid fa-floppy-disk"></i> Save
            </button>
        </div>
    }

</div>