@model IEnumerable<TicketModel.Models.TicketModel>
@using System.Linq
@{
    ViewBag.Title = "System Administration";
    ViewBag.ActiveTab = "AdminTickets";
    var supportList = ViewBag.SupportExecutives as List<TicketModel.Models.UserListModel>;
    var unassigned = ViewBag.UnassignedTickets as List<TicketModel.Models.TicketModel>;
    var assigned = ViewBag.AssignedTickets as List<TicketModel.Models.TicketModel>;
    var showList = ViewBag.CurrentView == "assigned" ? assigned : unassigned;
    int totalCount = Model == null ? 0 : Model.Count();
    int openCount = Model == null ? 0 : Model.Count(t => t.StatusId == 1);
    int activeCount = Model == null ? 0 : Model.Count(t => t.StatusId == 2 || t.StatusId == 3);
    int resolvedCount = Model == null ? 0 : Model.Count(t => t.StatusId == 4);
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
    <div>
        <div class="accent-text">Admin Management</div>
        <h2 class="luxury-heading" style="font-size: 28px; margin-top: 4px; margin-bottom: 0;">System All Tickets</h2>
    </div>
    <div style="display: flex; gap: 12px;">
        <a href="@Url.Action("ManageUsers", "Admin")" class="btn-secondary-gold"><i class="fa-solid fa-users-gear"></i> Manage Users</a>
        <a href="@Url.Action("CreateTicket", "Admin")" class="btn-primary-gold"><i class="fa-solid fa-plus"></i> Create Ticket</a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-ticket"></i></div>
        <div><div class="stat-number">@totalCount</div><div class="stat-label">Total System Tickets</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="color: var(--warning);"><i class="fa-solid fa-folder-open"></i></div>
        <div><div class="stat-number">@openCount</div><div class="stat-label">Open / Unassigned</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="color: var(--info);"><i class="fa-solid fa-spinner"></i></div>
        <div><div class="stat-number">@activeCount</div><div class="stat-label">Active Resolutions</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="color: var(--success);"><i class="fa-solid fa-circle-check"></i></div>
        <div><div class="stat-number">@resolvedCount</div><div class="stat-label">Resolved Tickets</div></div>
    </div>
</div>

<div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center;">
    @if (ViewBag.CurrentView == "assigned")
    {
        <a href="@Url.Action("AllTickets", new { view = "unassigned", search = ViewBag.Search, date = ViewBag.SelectedDate, assignedToUserId = ViewBag.AssignedToFilter, sortOrder = ViewBag.SortOrder })" class="btn-secondary-gold" onclick="clearState()">
            <i class="fa-solid fa-inbox"></i> Switch to Unassigned Tickets
        </a>
    }
    else
    {
        <a href="@Url.Action("AllTickets", new { view = "assigned", search = ViewBag.Search, date = ViewBag.SelectedDate, assignedToUserId = ViewBag.AssignedToFilter, sortOrder = ViewBag.SortOrder })" class="btn-primary-gold" onclick="clearState()">
            <i class="fa-solid fa-check-double"></i> Switch to Assigned Tickets
        </a>
    }
    <div style="font-weight: 700; color: var(--accent-primary); font-size: 14px; margin-left: auto;">
        Viewing: @(ViewBag.CurrentView == "assigned" ? "Assigned Tickets" : "Unassigned Tickets")
    </div>
</div>

<!-- Filter Bar -->
<div class="luxury-card" style="padding: 20px; margin-bottom: 28px; position: relative; z-index: 100;">
    @using (Html.BeginForm("AllTickets", "Admin", FormMethod.Get, new { id = "adminFilterForm", style = "display: flex; gap: 14px; align-items: center; flex-wrap: wrap;" }))
    {
        <input type="hidden" name="view" value="@ViewBag.CurrentView" />

        <div style="flex-grow: 1; min-width: 240px;">
            <input type="text" name="search" id="searchInput" value="@ViewBag.Search" placeholder="Search title, user, description..." class="form-control" />
        </div>

        <div class="dropdown" style="position: relative;">
            <button type="button" class="btn-secondary-gold dropdown-toggle" data-toggle="dropdown" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px;">
                <i class="fa-solid fa-filter" style="font-size: 16px; color: var(--accent-primary);"></i>
                <span>Filter</span>
                <i class="fa-solid fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-right funnel-filter-panel" onclick="event.stopPropagation();">
                <div style="font-weight: 700; color: var(--accent-primary); font-size: 13px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                    <span><i class="fa-solid fa-filter" style="margin-right: 4px;"></i> Funnel Filter</span>
                    <span style="font-size: 10px; color: var(--text-secondary); font-weight: normal;">Options</span>
                </div>
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-user-gear" style="margin-right: 4px;"></i> Filter by Support Staff
                    </label>
                    <select name="assignedToUserId" id="assignedToUserId" class="form-control" style="font-size: 13px;">
                        <option value="">1. All Support Staff</option>
                        @if (supportList != null)
                        {
                            int num = 2;
                            foreach (var s in supportList)
                            {
                                <option value="@s.UserId" @(ViewBag.AssignedToFilter != null && (int)ViewBag.AssignedToFilter == s.UserId ? "selected" : "")>@num. @s.UserName</option>
                                num++;
                            }
                        }
                    </select>
                </div>
                <div style="margin-bottom: 16px; background: var(--bg-tertiary); padding: 14px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                    <label class="form-label" style="font-size: 12px; margin-bottom: 6px; color: var(--accent-primary);">
                        <i class="fa-solid fa-calendar-days" style="margin-right: 4px;"></i> Filter by Date &amp; Sort
                    </label>
                    <select name="sortOrder" id="sortOrder" class="form-control" style="margin-bottom: 10px; font-size: 13px;">
                        <option value="newest" @(ViewBag.SortOrder == "oldest" ? "" : "selected")>1. Newest to Oldest</option>
                        <option value="oldest" @(ViewBag.SortOrder == "oldest" ? "selected" : "")>2. Oldest to Newest</option>
                    </select>
                    <label class="form-label" style="font-size: 11px; margin-bottom: 4px; color: var(--text-secondary);">Specific Date Filter</label>
                    <input type="date" name="date" id="dateFilter" value="@ViewBag.SelectedDate" class="form-control" style="font-size: 13px;" />
                </div>
                <div style="display: flex; gap: 10px; margin-top: 14px;">
                    <button type="submit" class="btn-primary-gold" style="flex: 1; padding: 6px 0; font-size: 12px;" onclick="clearState()">
                        <i class="fa-solid fa-check"></i> Apply
                    </button>
                    <a href="@Url.Action("AllTickets", "Admin")" class="btn-secondary-gold" style="padding: 6px 12px; font-size: 12px; border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearState()">
                        Reset
                    </a>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary-gold" onclick="clearState()"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        <a href="@Url.Action("AllTickets", "Admin")" class="btn-secondary-gold" style="border-color: var(--border-subtle); color: var(--text-secondary);" onclick="clearState()"><i class="fa-solid fa-rotate-left"></i> Reset</a>
    }
</div>

<!-- Table -->
<div class="luxury-table-wrapper">
    @if (showList != null && showList.Any())
    {
        <table class="luxury-table" id="ticketsTable">
            <thead>
                <tr>
                    <th>Ticket ID</th>
                    <th>Complaint Title</th>
                    <th>Raised By</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="ticketsBody">
                @foreach (var item in showList)
                {
                    string statusClass = item.StatusId == 1 ? "badge-status-open"
                                       : item.StatusId == 2 ? "badge-status-inprogress"
                                       : item.StatusId == 3 ? "badge-status-pending"
                                       : item.StatusId == 4 ? "badge-status-closed" : "badge-status-onhold";
                    string statusText = item.StatusId == 1 ? "Open"
                                      : item.StatusId == 2 ? "In Progress"
                                      : item.StatusId == 3 ? "On Hold"
                                      : item.StatusId == 4 ? "Closed" : "Unknown";

                    <tr class="ticket-row" style="display:none;">
                        <td style="font-weight: 700; color: var(--accent-primary); font-family: monospace;">TICK-@item.TicketId.ToString("D4")</td>
                        <td style="font-weight: 600;">@item.Title</td>
                        <td style="color: var(--text-primary); font-size: 13px;">@item.RaisedByName</td>
                        <td style="color: var(--text-secondary); font-size: 13px;">@(string.IsNullOrEmpty(item.AssignedToName) ? "Unassigned" : item.AssignedToName)</td>
                        <td><span class="badge-pill-luxury @statusClass">@statusText</span></td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 8px;">
                                <a href="@Url.Action("ManageTicket", "Admin", new { id = item.TicketId })"
                                   class="btn-primary-gold" style="padding: 6px 12px; font-size: 12px;"
                                   onclick="saveState()">
                                    <i class="fa-solid fa-gear"></i> Handle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="paginationBar" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap;"></div>
        <div id="pageInfo" style="text-align: center; font-size: 12px; color: var(--text-tertiary); margin-top: 8px;"></div>
    }
    else
    {
        <div style="padding: 48px; text-align: center; color: var(--text-secondary);">
            <i class="fa-solid fa-inbox" style="font-size: 48px; color: var(--accent-primary); margin-bottom: 16px;"></i>
            <h3 style="color: var(--text-primary);">No tickets in this view</h3>
            <p>No @(ViewBag.CurrentView == "assigned" ? "assigned" : "unassigned") tickets match your criteria.</p>
        </div>
    }
</div>

@section scripts {
    <script>
    var PAGE_SIZE = 6;
    var STORAGE_KEY = 'adminTickets_state';
    var currentPage = 1;

    // Current server-rendered filter values
    var currentState = {
        page: 1,
        search:    '@Html.Raw((ViewBag.Search ?? "").ToString())',
        date:      '@Html.Raw((ViewBag.SelectedDate ?? "").ToString())',
        sortOrder: '@Html.Raw((ViewBag.SortOrder ?? "newest").ToString())',
        assigned:  '@Html.Raw((ViewBag.AssignedToFilter != null ? ViewBag.AssignedToFilter.ToString() : ""))',
        view:      '@Html.Raw((ViewBag.CurrentView ?? "unassigned").ToString())'
    };

    function saveState() {
        currentState.page = currentPage;
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(currentState));
    }

    function clearState() {
        sessionStorage.removeItem(STORAGE_KEY);
    }

    function loadAndRedirectIfNeeded() {
        var saved = sessionStorage.getItem(STORAGE_KEY);
        if (!saved) return false;

        var state = JSON.parse(saved);

        // Check if current URL already matches the saved filter state
        var filtersMatch =
            state.search    === currentState.search &&
            state.date      === currentState.date &&
            state.sortOrder === currentState.sortOrder &&
            state.assigned  === currentState.assigned &&
            state.view      === currentState.view;

        if (filtersMatch) {
            // Filters already applied � just restore page
            currentPage = parseInt(state.page) || 1;
            return false;
        }

        // Filters don't match � we need to redirect with saved filters
        var url = '/Admin/AllTickets?view=' + encodeURIComponent(state.view);
        if (state.search)    url += '&search='           + encodeURIComponent(state.search);
        if (state.date)      url += '&date='             + encodeURIComponent(state.date);
        if (state.sortOrder) url += '&sortOrder='        + encodeURIComponent(state.sortOrder);
        if (state.assigned)  url += '&assignedToUserId=' + encodeURIComponent(state.assigned);

        // Store page so after redirect we restore it
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        window.location.href = url;
        return true;
    }

    function renderPage(page) {
        var rows = document.querySelectorAll('.ticket-row');
        var total = rows.length;
        var totalPages = Math.ceil(total / PAGE_SIZE);
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages || 1;
        currentPage = page;

        var start = (page - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;

        rows.forEach(function (row, i) {
            row.style.display = (i >= start && i < end) ? '' : 'none';
        });

        renderPagination(page, totalPages, total);
    }

    function renderPagination(page, totalPages, total) {
        var bar  = document.getElementById('paginationBar');
        var info = document.getElementById('pageInfo');
        if (!bar) return;
        bar.innerHTML = '';

        if (totalPages <= 1) {
            if (info) info.textContent = total > 0 ? 'Showing all ' + total + ' tickets' : '';
            return;
        }

        // Prev
        var prev = document.createElement('button');
        prev.className = page === 1 ? 'btn-secondary-gold' : 'btn-primary-gold';
        prev.style.cssText = 'padding: 6px 14px; font-size: 13px;';
        prev.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
        prev.disabled = page === 1;
        prev.onclick = function () { renderPage(page - 1); saveState(); };
        bar.appendChild(prev);

        // Pages
        var startPage = Math.max(1, page - 2);
        var endPage   = Math.min(totalPages, page + 2);

        if (startPage > 1) {
            appendPageBtn(bar, 1, page);
            if (startPage > 2) { bar.appendChild(makeDots()); }
        }

        for (var i = startPage; i <= endPage; i++) { appendPageBtn(bar, i, page); }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) { bar.appendChild(makeDots()); }
            appendPageBtn(bar, totalPages, page);
        }

        // Next
        var next = document.createElement('button');
        next.className = page === totalPages ? 'btn-secondary-gold' : 'btn-primary-gold';
        next.style.cssText = 'padding: 6px 14px; font-size: 13px;';
        next.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
        next.disabled = page === totalPages;
        next.onclick = function () { renderPage(page + 1); saveState(); };
        bar.appendChild(next);

        var s = (page - 1) * PAGE_SIZE + 1;
        var e = Math.min(page * PAGE_SIZE, total);
        if (info) info.textContent = 'Showing ' + s + ' � ' + e + ' of ' + total + ' tickets';
    }

    function appendPageBtn(bar, num, activePage) {
        var btn = document.createElement('button');
        btn.textContent = num;
        btn.style.cssText = 'padding: 6px 12px; font-size: 13px; min-width: 36px;' + (num === activePage ? 'font-weight: 700;' : '');
        btn.className = num === activePage ? 'btn-primary-gold' : 'btn-secondary-gold';
        btn.onclick = (function (n) { return function () { renderPage(n); saveState(); }; })(num);
        bar.appendChild(btn);
    }

    function makeDots() {
        var s = document.createElement('span');
        s.textContent = '...';
        s.style.cssText = 'color: var(--text-tertiary); padding: 0 4px; font-size: 13px;';
        return s;
    }

    document.addEventListener('DOMContentLoaded', function () {
        var rows = document.querySelectorAll('.ticket-row');
        if (rows.length === 0) return;

        var redirecting = loadAndRedirectIfNeeded();
        if (!redirecting) {
            renderPage(currentPage);
        }
    });
    </script>
}
